<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="draft" prototype="WorkItem">
  <transitions>
    <transition action="submit" from="draft" to="inReview"/>
    <transition action="submit" from="inRevision" to="inReview"/>
    <transition action="returnForRework" from="inReview" to="draft"/>
    <transition action="approve" from="inReview" to="approved"/>
    <transition action="reopen" from="approved" to="inRevision"/>
    <transition action="obsolete" from="approved" to="obsolete"/>
    <transition action="obsolete" from="inRevision" to="obsolete"/>
    <transition action="obsolete" from="draft" to="obsolete"/>
  </transitions>
  <actions>
    <action id="submit" name="Soumettre">
      <required><field name="title"/><field name="discipline"/><field name="informationClassification"/><field name="exportControl"/><field name="functionLevel"/><field name="functionType"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="disciplineEngineer,technicalLead"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-classification.js"/></condition>
      </conditions>
    </action>
    <action id="returnForRework" name="Retourner pour reprise">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="verifier,technicalLead"/></condition>
      </conditions>
    </action>
    <action id="approve" name="Approuver">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="verifier,technicalLead,approver"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-no-suspect.js"/><param name="roles" value="satisfies,assumes,branched_from,derived_from"/></condition>
      </conditions>
    </action>
    <action id="reopen" name="Rouvrir">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead,configurationManager"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-link-cardinality.js"/><param name="rule" value="role=impacts; direction=incoming; fromType=changeRequest; linkedStatus=[ccbApproved,implementation]; min=1; onlyIfInBaseline=true"/></condition>
      </conditions>
    </action>
    <action id="obsolete" name="Rendre obsolète">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="configurationManager,technicalLead"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
