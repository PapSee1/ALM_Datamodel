<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="open" prototype="WorkItem">
  <transitions>
    <transition action="confirm" from="open" to="confirmed"/>
    <transition action="invalidate" from="open" to="invalidated"/>
    <transition action="invalidate" from="confirmed" to="invalidated"/>
    <transition action="reopen" from="confirmed" to="open"/>
    <transition action="reopen" from="invalidated" to="open"/>
    <transition action="withdraw" from="open" to="withdrawn"/>
  </transitions>
  <actions>
    <action id="confirm" name="Confirmer">
      <required><field name="validationMethod"/><field name="discipline"/><field name="assumptionType"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead,disciplineEngineer"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
      </conditions>
      <!-- signature électronique : verified ; intention conditionnelle (safetyRelevant = yes) rendue systématique (la signature Polarion n'est pas conditionnelle) -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="invalidate" name="Infirmer">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead,disciplineEngineer"/></condition>
      </conditions>
      <functions>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-notify.js"/><param name="args" value="roles=[technicalLead,requirementsManager,safetyEngineer]; scope=propriétaires des éléments liés par 'assumes'"/></function>
      </functions>
    </action>
    <action id="reopen" name="Rouvrir (donnée modifiée)">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead"/></condition>
      </conditions>
    </action>
    <action id="withdraw" name="Retirer">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
