<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="draft" prototype="WorkItem">
  <transitions>
    <transition action="validate" from="draft" to="validated"/>
    <transition action="publish" from="validated" to="published"/>
    <transition action="withdraw" from="draft" to="withdrawn"/>
    <transition action="withdraw" from="validated" to="withdrawn"/>
    <transition action="withdraw" from="published" to="withdrawn"/>
  </transitions>
  <actions>
    <action id="validate" name="Valider">
      <required><field name="lessonRecommendation"/><field name="lessonCategory"/><field name="discipline"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead,qualityEngineer"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
        <condition name="LinkedWorkItem"><param name="link.role" value="capitalizes"/><param name="backlink" value="false"/></condition>
      </conditions>
    </action>
    <action id="publish" name="Publier (bibliothèque REX)">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="qualityEngineer,libraryCurator"/></condition>
      </conditions>
      <functions>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-notify.js"/><param name="args" value="roles=[requirementsManager,technicalLead]; scope=projets dont le palier / produit correspond (applicablePlantSeries)"/></function>
      </functions>
    </action>
    <action id="withdraw" name="Retirer">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="qualityEngineer"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
