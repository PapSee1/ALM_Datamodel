  <field id="commitmentSource" name="Origine" type="enum:commitmentSource" required="true"/>
  <field id="requestCategory" name="Nature" type="enum:requestCategory"/>
  <field id="authorityReference" name="Référence du courrier / décision" type="string" required="true"/>
  <field id="requestText" name="Texte de la demande" type="text/html"/>
  <field id="commitmentText" name="Réponse / engagement" type="text/html"/>
  <field id="commitmentDueDate" name="Échéance" type="date" required="true"/>
  <field id="responseReference" name="Référence de la réponse" type="string"/>
  <field id="licensee" name="Exploitant concerné" type="string"/>
</fields>
