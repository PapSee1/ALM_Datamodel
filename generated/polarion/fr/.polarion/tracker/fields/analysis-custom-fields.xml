  <field id="aip" name="Produit d'une AIP" type="enum:yesNoTbd" description="Activité importante pour la protection → contrôle technique indépendant obligatoire."/>
  <field id="analysisType" name="Type" type="enum:analysisType" required="true"/>
  <field id="calculationCode" name="Code / outil de calcul" type="string"/>
  <field id="codeVersion" name="Version du code" type="string"/>
  <field id="codeQualification" name="Statut du code" type="enum:codeQualification"/>
  <field id="inputDataSummary" name="Données d'entrée" type="text/html"/>
  <field id="conclusion" name="Conclusion" type="text/html"/>
  <field id="analysisResult" name="Résultat" type="enum:analysisResult"/>
  <field id="minimumMargin" name="Marge minimale obtenue" type="string"/>
  <field id="ageingMechanisms" name="Mécanismes de vieillissement traités" type="enum:ageingMechanism" multi="true"/>
</fields>
