  <field id="dataOwner" name="Détenteur de la donnée" type="string"/>
  <field id="validationMethod" name="Mode de confirmation" type="text/html"/>
  <field id="consequenceIfInvalid" name="Conséquence si infirmée" type="text/html"/>
  <field id="confirmationDueDate" name="Échéance de confirmation" type="date"/>
  <field id="safetyRelevant" name="Pertinente pour la sûreté" type="enum:yesNoTbd"/>
</fields>
