  <field id="applicableTechnologies" name="Filières applicables" type="enum:reactorTechnology" description="Abstraction de filière (REP, REB, VVER, CANDU, MTR, Gen IV, hors réacteur) : évite de coder le vocabulaire REP dans la structure." multi="true"/>
  <field id="transitionNote" name="Motif de la dernière transition" type="text" description="Exigé par les transitions de retour, rejet, réouverture, annulation (l'historique conserve toutes les valeurs)."/>
  <field id="verificationMethod" name="Méthode" type="enum:verificationMethod"/>
  <field id="vvType" name="Nature" type="enum:vvType"/>
  <field id="vvStage" name="Étape" type="enum:vvStage"/>
  <field id="vvLevel" name="Niveau" type="enum:reqLevel"/>
  <field id="acceptanceCriteria" name="Critères d'acceptation" type="text/html"/>
  <field id="preconditions" name="Préconditions / configuration" type="text/html"/>
  <field id="testSteps" name="Étapes" type="struct:TestSteps"/>
  <field id="testEnvironment" name="Environnement" type="enum:testEnvironment"/>
  <field id="procedureReference" name="Procédure / mode opératoire" type="string"/>
  <field id="inspectionPoint" name="Point d'inspection" type="enum:inspectionPoint"/>
  <field id="witnessParties" name="Parties convoquées" type="enum:witnessParty" multi="true"/>
  <field id="independenceLevel" name="Indépendance requise" type="enum:independenceLevel"/>
  <field id="qualificationStandard" name="Norme de qualification" type="string" description="Ex. IEC/IEEE 60780-323, IEC/IEEE 60980-344, IEC 62003."/>
  <field id="evidenceReference" name="Référence de la preuve (PV, note)" type="string"/>
  <field id="estimatedDuration" name="Durée estimée" type="duration"/>
  <field id="regressionRequired" name="À rejouer en non-régression" type="boolean"/>
  <field id="requiredHabilitation" name="Habilitation requise du vérificateur / approbateur" type="enum:habilitationDomain"/>
  <field id="lastResult" name="Dernier résultat (calculé)" type="enum:vvStatus" description="[Calculé – alimenté par script, ne pas saisir]"/>
