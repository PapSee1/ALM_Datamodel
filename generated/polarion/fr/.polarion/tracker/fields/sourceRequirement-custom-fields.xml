  <field id="safetyRelevant" name="Pertinente pour la sûreté" type="enum:yesNoTbd"/>
  <field id="verificationStatus" name="Statut de vérification (calculé)" type="enum:vvStatus" description="[Calculé – alimenté par script, ne pas saisir]"/>
