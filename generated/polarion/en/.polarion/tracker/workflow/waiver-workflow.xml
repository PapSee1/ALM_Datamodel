<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="requested" prototype="WorkItem">
  <transitions>
    <transition action="review" from="requested" to="technicalReview"/>
    <transition action="toExternal" from="technicalReview" to="pendingExternal"/>
    <transition action="approveInternal" from="technicalReview" to="approved"/>
    <transition action="approveExternal" from="pendingExternal" to="approved"/>
    <transition action="reject" from="technicalReview" to="rejected"/>
    <transition action="reject" from="pendingExternal" to="rejected"/>
    <transition action="expire" from="approved" to="expired"/>
  </transitions>
  <actions>
    <action id="review" name="Review">
      <required><field name="waiverType"/><field name="waiverJustification"/><field name="affectsEip"/><field name="effectivity"/><field name="discipline"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead,configurationManager"/></condition>
      </conditions>
    </action>
    <action id="toExternal" name="Submit to customer / authority">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-field-rule.js"/><param name="rule" value="field=affectsEip; notIn=[tbd]"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-safety-approval.js"/><param name="rule" value="affectsEip = yes"/></condition>
      </conditions>
      <!-- signature électronique : verified ; signature systématique -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="approveInternal" name="Grant (internal, no external approval needed)">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="approver"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-field-rule.js"/><param name="rule" value="field=affectsEip; in=[no]"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
      </conditions>
      <!-- signature électronique : approved ; signature systématique -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="approveExternal" name="Record the approval">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead,configurationManager"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-field-rule.js"/><param name="rule" value="nonEmptyAny=[customerApprovalReference,authorityApprovalReference]"/></condition>
      </conditions>
      <!-- signature électronique : approved ; signature systématique -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="reject" name="Refuse">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="approver,technicalLead"/></condition>
      </conditions>
    </action>
    <action id="expire" name="Close / expire">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="configurationManager"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
