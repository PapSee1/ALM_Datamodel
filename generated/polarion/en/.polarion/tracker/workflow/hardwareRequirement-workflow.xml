<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="draft" prototype="WorkItem">
  <transitions>
    <transition action="submit" from="draft" to="inReview"/>
    <transition action="submit" from="inRevision" to="inReview"/>
    <transition action="returnForRework" from="inReview" to="draft"/>
    <transition action="approve" from="inReview" to="approved"/>
    <transition action="reopen" from="approved" to="inRevision"/>
    <transition action="obsolete" from="approved" to="obsolete"/>
    <transition action="obsolete" from="inRevision" to="obsolete"/>
    <transition action="reject" from="draft" to="rejected"/>
    <transition action="reject" from="inReview" to="rejected"/>
  </transitions>
  <actions>
    <action id="submit" name="Submit for verification">
      <required><field name="title"/><field name="description"/><field name="discipline"/><field name="reqCategory"/><field name="safetyRelevant"/><field name="definedRequirement"/><field name="informationClassification"/><field name="exportControl"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="disciplineEngineer,requirementsManager,safetyEngineer"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-classification.js"/></condition>
      </conditions>
      <functions>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-request-safety-approval.js"/><param name="args" value="onlyIf=safetyRelevant = yes OR definedRequirement = yes"/></function>
      </functions>
    </action>
    <action id="returnForRework" name="Return for rework">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="verifier,approver,safetyEngineer,requirementsManager"/></condition>
      </conditions>
    </action>
    <action id="approve" name="Approve">
      <required><field name="verificationMethods"/><field name="acceptanceCriteria"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="verifier,approver"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-no-suspect.js"/><param name="roles" value="flowsDownFrom,assumes,branched_from,derived_from"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-safety-approval.js"/><param name="rule" value="definedRequirement = yes OR safetyRelevant = yes"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-field-rule.js"/><param name="rule" value="field=maturity; notIn=[tbd]"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-field-rule.js"/><param name="rule" value="field=definedRequirement; notIn=[tbd]"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-field-rule.js"/><param name="rule" value="field=safetyRelevant; notIn=[tbd]"/></condition>
      </conditions>
      <functions>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-set-if-empty.js"/><param name="args" value="field=maturity; value=consolidated"/></function>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-verification-status.js"/></function>
      </functions>
    </action>
    <action id="reopen" name="Reopen under change request">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="requirementsManager,configurationManager"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-link-cardinality.js"/><param name="rule" value="role=impacts; direction=incoming; fromType=changeRequest; linkedStatus=[ccbApproved,implementation]; min=1; onlyIfInBaseline=true"/></condition>
      </conditions>
    </action>
    <action id="obsolete" name="Make obsolete">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="configurationManager,requirementsManager"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-link-cardinality.js"/><param name="rule" value="role=impacts; direction=incoming; fromType=changeRequest; linkedStatus=[ccbApproved,implementation,verification,closed]; min=1"/></condition>
      </conditions>
    </action>
    <action id="reject" name="Reject / abandon">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="requirementsManager,technicalLead"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
