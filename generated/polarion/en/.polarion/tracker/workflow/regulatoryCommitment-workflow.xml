<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="registered" prototype="WorkItem">
  <transitions>
    <transition action="plan" from="registered" to="planned"/>
    <transition action="start" from="planned" to="inProgress"/>
    <transition action="submitResponse" from="inProgress" to="responseSubmitted"/>
    <transition action="reopen" from="responseSubmitted" to="inProgress"/>
    <transition action="close" from="responseSubmitted" to="closed"/>
    <transition action="cancel" from="registered" to="cancelled"/>
    <transition action="cancel" from="planned" to="cancelled"/>
  </transitions>
  <actions>
    <action id="plan" name="Établir le plan de réponse">
      <required><field name="commitmentDueDate"/><field name="assignee"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="licensingEngineer,projectManager"/></condition>
      </conditions>
    </action>
    <action id="start" name="Démarrer">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="licensingEngineer,disciplineEngineer"/></condition>
      </conditions>
    </action>
    <action id="submitResponse" name="Transmettre la réponse">
      <required><field name="commitmentText"/><field name="responseReference"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="licensingEngineer"/></condition>
        <condition name="LinkedWorkItem"><param name="link.role" value="resolves"/><param name="backlink" value="true"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
      </conditions>
      <!-- signature : approved -->
      <signatures/>
    </action>
    <action id="reopen" name="Compléter (réponse jugée insuffisante)">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="licensingEngineer"/></condition>
      </conditions>
    </action>
    <action id="close" name="Solder">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="licensingEngineer"/></condition>
      </conditions>
    </action>
    <action id="cancel" name="Déclarer sans objet">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="licensingEngineer"/></condition>
      </conditions>
      <!-- signature : approved -->
      <signatures/>
    </action>
  </actions>
</workflow>
