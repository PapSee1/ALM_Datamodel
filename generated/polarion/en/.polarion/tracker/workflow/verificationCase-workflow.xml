<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="draft" prototype="WorkItem">
  <transitions>
    <transition action="submit" from="draft" to="inReview"/>
    <transition action="submit" from="inRevision" to="inReview"/>
    <transition action="returnForRework" from="inReview" to="draft"/>
    <transition action="approve" from="inReview" to="approved"/>
    <transition action="reopen" from="approved" to="inRevision"/>
    <transition action="obsolete" from="approved" to="obsolete"/>
    <transition action="obsolete" from="inRevision" to="obsolete"/>
    <transition action="obsolete" from="draft" to="obsolete"/>
  </transitions>
  <actions>
    <action id="submit" name="Submit">
      <required><field name="verificationMethod"/><field name="vvStage"/><field name="acceptanceCriteria"/><field name="discipline"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="vvEngineer,disciplineEngineer"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-link-cardinality.js"/><param name="rule" value="role=[verifies,validates]; direction=outgoing; min=1"/></condition>
      </conditions>
    </action>
    <action id="returnForRework" name="Return for rework">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="verifier,vvLead"/></condition>
      </conditions>
    </action>
    <action id="approve" name="Approve">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="verifier,vvLead"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-habilitation.js"/><param name="rule" value="field=requiredHabilitation; level=verifier"/><param name="projectParameter" value="signaturePolicy"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-no-suspect.js"/><param name="roles" value="verifies,validates"/></condition>
      </conditions>
    </action>
    <action id="reopen" name="Reopen">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="vvLead,configurationManager"/></condition>
      </conditions>
    </action>
    <action id="obsolete" name="Make obsolete">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="vvLead"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
