<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="new" prototype="WorkItem">
  <transitions>
    <transition action="triage" from="new" to="triaged"/>
    <transition action="analyse" from="triaged" to="inAnalysis"/>
    <transition action="propose" from="inAnalysis" to="solutionProposed"/>
    <transition action="accept" from="solutionProposed" to="solutionAccepted"/>
    <transition action="rework" from="solutionProposed" to="inAnalysis"/>
    <transition action="implement" from="solutionAccepted" to="implemented"/>
    <transition action="close" from="implemented" to="closed"/>
    <transition action="escalate" from="triaged" to="cancelled"/>
    <transition action="escalate" from="inAnalysis" to="cancelled"/>
    <transition action="cancel" from="new" to="cancelled"/>
    <transition action="cancel" from="triaged" to="cancelled"/>
  </transitions>
  <actions>
    <action id="triage" name="Take over (triage)">
      <required><field name="discipline"/><field name="issueCategory"/><field name="urgency"/><field name="safetyImpact"/><field name="assignee"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager,technicalLead"/></condition>
      </conditions>
      <functions>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-sla.js"/><param name="args" value="byUrgency=immediate=24h; urgent=72h; high=14d; normal=30d; field=responseDueDate"/></function>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-notify.js"/><param name="args" value="roles=[safetyEngineer]; onlyIf=safetyImpact = yes"/></function>
      </functions>
    </action>
    <action id="analyse" name="Analyse">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="disciplineEngineer,technicalLead"/></condition>
      </conditions>
    </action>
    <action id="propose" name="Verify and propose the solution (technical check)">
      <required><field name="solutionType"/><field name="affectsEip"/><field name="espnImpact"/><field name="genericImpact"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead,verifier"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-field-rule.js"/><param name="rule" value="field=affectsEip; notIn=[tbd]"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-field-rule.js"/><param name="rule" value="field=safetyImpact; notIn=[tbd]"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-safety-approval.js"/><param name="rule" value="affectsEip = yes OR safetyImpact = yes"/></condition>
        <condition name="LinkedWorkItem"><param name="link.role" value="resolves"/><param name="backlink" value="true"/></condition>
      </conditions>
      <!-- signature électronique : verified ; intention conditionnelle (affectsEip = yes OR safetyImpact = yes) rendue systématique (la signature Polarion n'est pas conditionnelle) -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="accept" name="Record customer acceptance">
      <required><field name="customerRequestReference"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager,technicalLead"/></condition>
      </conditions>
    </action>
    <action id="rework" name="Resume analysis">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead"/></condition>
      </conditions>
    </action>
    <action id="implement" name="Declare implemented">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead"/></condition>
      </conditions>
    </action>
    <action id="close" name="Close">
      <required><field name="lessonsLearnedCaptured"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-field-rule.js"/><param name="rule" value="field=lessonsLearnedCaptured; equals=true"/></condition>
      </conditions>
    </action>
    <action id="escalate" name="Requalify (as NCR / change request / project)">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="technicalLead"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-link-cardinality.js"/><param name="rule" value="role=relates_to; direction=any; toType=[nonConformance,changeRequest]; min=1"/></condition>
      </conditions>
    </action>
    <action id="cancel" name="Close without action">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
