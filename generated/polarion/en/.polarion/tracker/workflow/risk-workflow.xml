<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="identified" prototype="WorkItem">
  <transitions>
    <transition action="assess" from="identified" to="assessed"/>
    <transition action="plan" from="assessed" to="treatment"/>
    <transition action="monitor" from="treatment" to="monitored"/>
    <transition action="occur" from="assessed" to="occurred"/>
    <transition action="occur" from="treatment" to="occurred"/>
    <transition action="occur" from="monitored" to="occurred"/>
    <transition action="close" from="assessed" to="closed"/>
    <transition action="close" from="treatment" to="closed"/>
    <transition action="close" from="monitored" to="closed"/>
    <transition action="reopen" from="closed" to="assessed"/>
    <transition action="reopen" from="monitored" to="assessed"/>
  </transitions>
  <actions>
    <action id="assess" name="Evaluate">
      <required><field name="probability"/><field name="impact"/><field name="riskCategory"/><field name="discipline"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager,workitem.assignee"/></condition>
      </conditions>
    </action>
    <action id="plan" name="Plan treatment">
      <required><field name="riskStrategy"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager,workitem.assignee"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-link-cardinality.js"/><param name="rule" value="role=mitigates; direction=incoming; min=1; unlessFieldIn=riskStrategy=[accept]"/></condition>
      </conditions>
    </action>
    <action id="monitor" name="Put under monitoring">
      <required><field name="residualProbability"/><field name="residualImpact"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager,workitem.assignee"/></condition>
      </conditions>
    </action>
    <action id="occur" name="Declare occurred">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager,workitem.assignee"/></condition>
      </conditions>
      <functions>
        <function name="CreateLinkedWorkItem"><param name="type" value="technicalIssue"/><param name="link.role" value="relates_to"/></function>
      </functions>
    </action>
    <action id="close" name="Close">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager"/></condition>
      </conditions>
    </action>
    <action id="reopen" name="Reassess">
      <required><field name="discipline"/></required>
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="projectManager,workitem.assignee"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
