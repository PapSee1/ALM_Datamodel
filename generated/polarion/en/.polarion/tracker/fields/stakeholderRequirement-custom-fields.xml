<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<fields>
  <field id="discipline" name="Lead discipline" type="enum:discipline" required="true"/>
  <field id="contributingDisciplines" name="Contributing disciplines" type="enum:discipline" multi="true"/>
  <field id="externalId" name="External ID" type="string" description="ID dans le document source, chez le client (ReqIF) ou dans l'outil hérité (migration)."/>
  <field id="sourceReference" name="Source reference" type="string" description="Document / révision / paragraphe d'origine."/>
  <field id="applicablePlantSeries" name="Applicable plant series" type="enum:plantSeries" multi="true"/>
  <field id="applicableUnits" name="Applicable units" type="enum:plantUnit" description="Énumération surchargée au niveau projet." multi="true"/>
  <field id="applicabilityCondition" name="Applicability condition" type="text" description="Règle de variante en clair (ou expression du modèle de variabilité)."/>
  <field id="lifecyclePhase" name="Phase" type="enum:lifecyclePhase"/>
  <field id="informationClassification" name="Information classification" type="enum:informationClassification" required="true"/>
  <field id="exportControl" name="Export control" type="enum:exportControl" required="true"/>
  <field id="wbsCode" name="WBS code" type="string"/>
  <field id="transitionNote" name="Last transition note" type="text" description="Exigé par les transitions de retour, rejet, réouverture, annulation (l'historique conserve toutes les valeurs)."/>
  <field id="reqCategory" name="Category" type="enum:reqCategory" required="true"/>
  <field id="bindingLevel" name="Binding level" type="enum:bindingLevel"/>
  <field id="rationale" name="Rationale" type="text/html"/>
  <field id="acceptanceCriteria" name="Acceptance criteria" type="text/html"/>
  <field id="verificationMethods" name="Verification methods" type="enum:verificationMethod" multi="true"/>
  <field id="vvStagesPlanned" name="Planned V&amp;V stages" type="enum:vvStage" multi="true"/>
  <field id="maturity" name="Maturity" type="enum:maturity"/>
  <field id="plantStates" name="Plant states" type="enum:plantState" multi="true"/>
  <field id="plantConditions" name="Plant conditions" type="enum:plantCondition" multi="true"/>
  <field id="verificationStatus" name="Verification status (computed)" type="enum:vvStatus" description="[Calculé – alimenté par script, ne pas saisir]"/>
  <field id="customerApprovalRequired" name="Customer approval required for change" type="enum:yesNoTbd"/>
  <field id="safetyRelevant" name="Safety relevant" type="enum:yesNoTbd" required="true"/>
  <field id="definedRequirement" name="Defined requirement (EIP)" type="enum:yesNoTbd" description="Exigence assignée à un EIP au sens de l'arrêté INB : déclenche le socle non négociable (contrôle technique, traçabilité V&amp;V, gestion d'écart)." required="true"/>
  <field id="protectedInterests" name="Protected interests" type="enum:protectedInterest" multi="true"/>
  <field id="safetyClassScheme" name="Classification scheme" type="enum:safetyClassScheme"/>
  <field id="safetyClass" name="Inherited safety class" type="enum:safetyClass" description="Classe la plus sévère des éléments auxquels l'exigence est allouée (contrôlée par rapport)."/>
  <field id="functionCategory" name="Inherited function category" type="enum:functionCategory"/>
  <field id="securityRelevant" name="Security relevant" type="enum:yesNoTbd"/>
  <field id="stakeholder" name="Stakeholders" type="enum:stakeholder" required="true" multi="true"/>
  <field id="needStatement" name="Need statement" type="text/html"/>
</fields>
