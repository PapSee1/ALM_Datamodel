<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="draft" prototype="Module">
  <transitions>
    <transition action="submit" from="draft" to="inApproval"/>
    <transition action="publish" from="inApproval" to="published"/>
    <transition action="revise" from="published" to="draft"/>
    <transition action="supersede" from="published" to="superseded"/>
  </transitions>
  <actions>
    <action id="submit" name="Submit">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="libraryCurator"/></condition>
      </conditions>
      <functions>
        <function name="InvokeAction"><param name="statusId" value="validated"/><param name="actionId" value="submit"/><param name="query" value="type:(term) AND status:(draft)"/></function>
      </functions>
      <!-- signature électronique : authored ; signature systématique -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="publish" name="Publish (new reference version)">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="libraryDesignAuthority"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
        <condition name="ContainsNoMatchingWorkItems"><param name="query" value="type:(term) AND NOT status:(published)"/></condition>
      </conditions>
      <functions>
        <function name="InvokeAction"><param name="statusId" value="published"/><param name="actionId" value="approve"/><param name="query" value="type:(term) AND status:(validated)"/></function>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-baseline.js"/><param name="args" value="nameTemplate=LIB-${document}-${revisionIndex}"/></function>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-notify.js"/><param name="args" value="roles=[requirementsManager]; scope=projets ayant réutilisé ce document"/></function>
      </functions>
      <!-- signature électronique : approved ; signature systématique -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="revise" name="Revise">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="libraryCurator"/></condition>
      </conditions>
      <functions>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-revision-index.js"/></function>
      </functions>
    </action>
    <action id="supersede" name="Supersede">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="libraryDesignAuthority"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
