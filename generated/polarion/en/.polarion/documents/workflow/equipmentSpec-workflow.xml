<?xml version="1.0" encoding="UTF-8"?>
<!-- GÉNÉRÉ par tools/generate_polarion.py depuis model/*.yaml – ne pas éditer à la main.
     Modifier le modèle, valider (tools/almmodel.py), régénérer, puis déployer via
     la procédure de configuration (Design Authority ALM). -->
<workflow initial-status="draft" prototype="Module">
  <transitions>
    <transition action="startReview" from="draft" to="inReview"/>
    <transition action="submitVerification" from="draft" to="inVerification"/>
    <transition action="submitVerification" from="inReview" to="inVerification"/>
    <transition action="returnToDraft" from="inReview" to="draft"/>
    <transition action="returnToDraft" from="inVerification" to="draft"/>
    <transition action="returnToDraft" from="inApproval" to="draft"/>
    <transition action="verify" from="inVerification" to="inApproval"/>
    <transition action="approve" from="inApproval" to="approved"/>
    <transition action="revise" from="approved" to="draft"/>
    <transition action="supersede" from="approved" to="superseded"/>
  </transitions>
  <actions>
    <action id="startReview" name="Start review">
      <conditions>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-document-owner.js"/></condition>
      </conditions>
    </action>
    <action id="submitVerification" name="Submit for verification">
      <conditions>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-document-owner.js"/></condition>
        <condition name="ContainsNoMatchingWorkItems"><param name="query" value="informationClassification.KEY:(sensitiveSecurity restricted)"/></condition>
      </conditions>
      <functions>
        <function name="InvokeAction"><param name="statusId" value="inReview"/><param name="actionId" value="submit"/><param name="query" value="type:(equipmentRequirement safetyRequirement verificationCase designParameter) AND status:(draft inRevision)"/></function>
      </functions>
      <!-- signature électronique : authored ; signature systématique -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="returnToDraft" name="Return to draft">
      <required><field name="transitionNote"/></required>
      <conditions>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-document-owner.js"/><param name="orRoles" value="verifier,approver"/></condition>
      </conditions>
    </action>
    <action id="verify" name="Verify">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="verifier"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-habilitation.js"/><param name="rule" value="field=requiredHabilitation; level=verifier"/><param name="projectParameter" value="signaturePolicy"/></condition>
        <condition name="ContainsNoMatchingWorkItems"><param name="query" value="suspect:true"/></condition>
      </conditions>
      <!-- signature électronique : verified ; signature systématique -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="approve" name="Approve">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="approver"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-independence.js"/></condition>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-habilitation.js"/><param name="rule" value="field=requiredHabilitation; level=approver"/><param name="projectParameter" value="signaturePolicy"/></condition>
        <condition name="ContainsNoMatchingWorkItems"><param name="query" value="type:(equipmentRequirement safetyRequirement verificationCase designParameter) AND NOT status:(approved)"/></condition>
        <condition name="ContainsNoMatchingWorkItems"><param name="query" value="type:interface AND NOT status:(agreed frozen)"/></condition>
      </conditions>
      <functions>
        <function name="InvokeAction"><param name="statusId" value="approved"/><param name="actionId" value="approve"/><param name="query" value="type:(equipmentRequirement safetyRequirement verificationCase designParameter) AND status:(inReview)"/></function>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-baseline.js"/><param name="args" value="nameTemplate=${document}-${revisionIndex}"/></function>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-export-edms.js"/></function>
      </functions>
      <!-- signature électronique : approved ; signature systématique -->
      <signatures><signature-policy name="all"/></signatures>
    </action>
    <action id="revise" name="New revision">
      <conditions>
        <condition name="ScriptCondition"><param name="engine" value="js"/><param name="script" value="fra-document-owner.js"/><param name="orRoles" value="configurationManager"/></condition>
      </conditions>
      <functions>
        <function name="ScriptFunction"><param name="engine" value="js"/><param name="script" value="fra-revision-index.js"/></function>
      </functions>
    </action>
    <action id="supersede" name="Supersede">
      <conditions>
        <condition name="RoleCondition"><param name="roles" value="configurationManager"/></condition>
      </conditions>
    </action>
  </actions>
</workflow>
